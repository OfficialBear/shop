.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  background: var(--surface-2);
}

.result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0 56rpx;
}

.icon {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: rgba(52, 199, 89, 0.12);
  color: var(--success);
  font-size: 76rpx;
  line-height: 144rpx;
  text-align: center;
}

.title {
  margin-top: 36rpx;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: -0.6rpx;
  color: var(--ink);
}

.sub {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}

.card {
  margin-top: 8rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  padding: 8rpx 32rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: var(--ink-2);
}

.value {
  font-size: 28rpx;
  color: var(--ink);
}

.value.price {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
  color: var(--ink);
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 56rpx;
}
