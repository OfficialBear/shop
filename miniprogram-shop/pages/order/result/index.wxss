.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f5f6f8;
}

.result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 48rpx;
}

.icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #ff6b00;
  color: #fff;
  font-size: 72rpx;
  line-height: 128rpx;
  text-align: center;
}

.title {
  margin-top: 32rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #222;
}

.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.card {
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #fff;
  padding: 8rpx 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #222;
}

.value.price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}
