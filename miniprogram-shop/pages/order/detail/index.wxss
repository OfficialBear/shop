.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 160rpx;
  background: #f5f6f8;
}

.banner {
  padding: 40rpx 32rpx;
  border-radius: 16rpx;
  background: #ff6b00;
  color: #fff;
}

.status {
  font-size: 40rpx;
  font-weight: 600;
}

.status-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.card {
  margin-top: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.goods-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-img {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.goods-spec {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.goods-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.goods-num {
  font-size: 26rpx;
  color: #999;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 24rpx 0;
}

.total-price {
  margin-left: 12rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.info-card .row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-card .row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #222;
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}
