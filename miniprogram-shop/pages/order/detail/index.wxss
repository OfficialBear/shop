.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 176rpx;
  background: var(--surface-2);
}

.banner {
  padding: 48rpx 36rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(150deg, #1c1e22 0%, #111214 100%);
  box-shadow: var(--shadow-card);
}

.status {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: -0.6rpx;
  color: #fff;
}

.status-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.62);
}

.card {
  margin-top: 24rpx;
  padding: 8rpx 32rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.goods-item {
  display: flex;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-img {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--surface-2);
}

.goods-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.goods-spec {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.goods-price {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.goods-num {
  font-size: 26rpx;
  color: var(--ink-3);
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 28rpx 0;
}

.total-price {
  margin-left: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
  color: var(--ink);
}

.info-card .row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.info-card .row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: var(--ink-2);
}

.value {
  font-size: 28rpx;
  color: var(--ink);
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 56rpx;
}
