.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 160rpx;
  background: #f5f6f8;
}

.card {
  border-radius: 16rpx;
  background: #fff;
  overflow: hidden;
}

.table-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.table-no {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b00;
}

.goods {
  padding: 0 24rpx;
}

.goods-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-img {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.goods-spec {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.goods-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.goods-num {
  font-size: 26rpx;
  color: #999;
}

.remark {
  padding: 24rpx;
}

.remark-input {
  width: 100%;
  height: 120rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #333;
}

.remark-ph {
  color: #bbb;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.total {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.total-price {
  font-size: 38rpx;
  font-weight: 600;
  color: #ff4d4f;
}
