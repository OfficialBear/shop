<view class="page">
  <view class="card">
    <view wx:if="{{tableNo}}" class="table-row">
      <text class="label">桌号</text>
      <text class="table-no">{{tableNo}}</text>
    </view>

    <view class="goods">
      <view wx:for="{{items}}" wx:key="id" class="goods-item">
        <t-image class="goods-img" src="{{item.image}}" mode="aspectFill" shape="round" />
        <view class="goods-info">
          <view class="goods-name">{{item.name}}</view>
          <view wx:if="{{item.specText}}" class="goods-spec">{{item.specText}}</view>
          <view class="goods-bottom">
            <text class="goods-price">¥{{item.price}}</text>
            <text class="goods-num">×{{item.number}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="remark">
      <text class="label">备注</text>
      <textarea class="remark-input" placeholder="口味、忌口等要求" placeholder-class="remark-ph" value="{{remark}}" maxlength="100" bindinput="onRemarkInput" />
    </view>
  </view>

  <view class="footer">
    <view class="total">合计 <text class="total-price">¥{{totalPrice}}</text></view>
    <t-button theme="primary" size="large" loading="{{submitting}}" bind:tap="onSubmit">提交订单</t-button>
  </view>
</view>
