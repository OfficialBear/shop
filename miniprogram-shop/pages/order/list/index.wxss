.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  background: var(--surface-2);
}

.order-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 0.2rpx;
}

.status {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-soft);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
}

.status-5 {
  color: var(--success);
  background: rgba(52, 199, 89, 0.1);
}

.status-6 {
  color: var(--ink-3);
  background: var(--surface-2);
}

.order-summary {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--hairline);
}

.amount {
  font-size: 26rpx;
  color: var(--ink-2);
}

.amount-price {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
  color: var(--ink);
  margin-left: 6rpx;
}

.order-actions {
  display: flex;
  gap: 16rpx;
}

.btn {
  padding: 14rpx 36rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-plain {
  border: 1rpx solid var(--hairline);
  background: var(--surface);
  color: var(--ink);
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 6rpx 16rpx var(--accent-shadow);
}

.empty {
  padding: 200rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--ink-3);
}

.loading {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}
