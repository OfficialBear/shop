.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--surface-2);
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  background: var(--surface);
  border-bottom: 1rpx solid var(--hairline);
}

.tab {
  position: relative;
  flex: 1;
  padding: 26rpx 0 24rpx;
  text-align: center;
}

.tab-text {
  font-size: 28rpx;
  color: var(--ink-2);
}

.tab-active .tab-text {
  color: var(--ink);
  font-weight: 600;
}

.tab-bar {
  display: none;
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 40rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--accent);
  transform: translateX(-50%);
}

.tab-active .tab-bar {
  display: block;
}

.list {
  padding: 24rpx 32rpx 40rpx;
}

.order-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-table {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.status {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-soft);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
}

.status-1 {
  color: #b26a00;
  background: #fdf1e0;
}

.status-5 {
  color: var(--success);
  background: rgba(52, 199, 89, 0.1);
}

.status-6 {
  color: var(--ink-3);
  background: var(--surface-2);
}

.order-body {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.thumbs {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.thumb {
  width: 96rpx;
  height: 96rpx;
  margin-right: 12rpx;
  border-radius: 18rpx;
  background: var(--surface-2);
}

.thumb-more {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ink-3);
  background: var(--surface-2);
}

.order-main {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
  display: flex;
  flex-direction: column;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.order-time {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--hairline);
}

.order-amount {
  display: flex;
  align-items: baseline;
}

.order-count {
  margin-right: 16rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.amount-price {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
  color: var(--ink);
}

.order-actions {
  display: flex;
  gap: 16rpx;
}

.btn {
  padding: 14rpx 36rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 600;
}

.btn-plain {
  border: 1rpx solid var(--hairline);
  background: var(--surface);
  color: var(--ink);
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 6rpx 16rpx var(--accent-shadow);
}

.empty {
  padding: 180rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  line-height: 1;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--ink-3);
}

.empty-btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 18rpx 56rpx;
  border-radius: var(--radius-pill);
  background: var(--accent);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx var(--accent-shadow);
}

.loading {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}
