.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--surface-2);
}

/* 顶部：大标题 + 搜索 */
.header {
  flex-shrink: 0;
  padding: 24rpx 32rpx 12rpx;
  background: #fff;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0 20rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--ink);
}

.table-tag {
  padding: 8rpx 22rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
}

/* 主体 */
.body {
  flex: 1;
  display: flex;
  overflow: hidden;
  min-height: 0;
}

/* 左侧分类 */
.sidebar {
  width: 176rpx;
  height: 100%;
  flex-shrink: 0;
  background: var(--surface-2);
}

.category-item {
  position: relative;
  padding: 34rpx 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  text-align: center;
  line-height: 1.4;
  transition: color 0.2s ease;
}

.category-item.active {
  color: var(--ink);
  font-weight: 600;
}

.category-item.active::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  background: var(--accent);
  border-radius: 3rpx;
}

.category-text {
  display: inline-block;
  font-size: 26rpx;
  line-height: 1.4;
}

/* 右侧菜品 */
.content {
  flex: 1;
  height: 100%;
  min-width: 0;
  background: #fff;
}

.category-section {
  padding: 0 32rpx;
}

.category-title {
  padding: 32rpx 0 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
  color: var(--ink);
}

.dish-item {
  display: flex;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-img {
  width: 168rpx;
  height: 168rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: var(--surface-2);
}

.dish-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  padding: 2rpx 0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-desc {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-sales {
  font-size: 22rpx;
  color: var(--ink-4);
  margin-top: 8rpx;
}

.dish-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.dish-price {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
  color: var(--ink);
}

.dish-price .symbol {
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 2rpx;
}

.content-bottom {
  height: 40rpx;
}

/* 菜品操作 */
.add-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 40rpx;
  line-height: 1;
  box-shadow: 0 6rpx 16rpx var(--accent-shadow);
  transition: transform 0.2s ease;
}

.add-btn:active {
  transform: scale(0.92);
}

.spec-btn {
  position: relative;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-pill);
  background: var(--accent);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: 0 6rpx 16rpx var(--accent-shadow);
}

.spec-count {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-radius: var(--radius-pill);
  background: var(--ink);
  color: #fff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
}

/* 底部购物车栏 */
.cart-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--hairline);
  box-shadow: 0 -6rpx 24rpx rgba(17, 18, 20, 0.04);
}

.cart-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}

.cart-price {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
  color: var(--ink);
}

.cart-price .empty {
  font-size: 26rpx;
  color: var(--ink-3);
  font-weight: 400;
}

.cart-btn {
  padding: 20rpx 52rpx;
  border-radius: 28rpx;
  background: #ebedee;
  color: var(--ink-4);
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.cart-btn.active {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 8rpx 20rpx var(--accent-shadow);
}

/* 规格弹层 */
.spec-panel {
  display: flex;
  flex-direction: column;
  max-height: 72vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.spec-header {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx 20rpx;
}

.spec-img {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: var(--surface-2);
}

.spec-meta {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.spec-name {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
  color: var(--ink);
}

.spec-price {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.spec-price .symbol {
  font-size: 22rpx;
  font-weight: 500;
}

.spec-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 28rpx;
}

.spec-body {
  max-height: 44vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.spec-group {
  padding: 20rpx 0;
}

.spec-group-title {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.spec-footer {
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--hairline);
}

/* 购物车弹层 */
.cart-panel {
  display: flex;
  flex-direction: column;
  max-height: 72vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.cart-panel-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.cart-panel-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
  color: var(--ink);
}

.cart-clear {
  margin-right: 24rpx;
  font-size: 26rpx;
  color: var(--ink-3);
}

.cart-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 28rpx;
}

.cart-list {
  max-height: 56vh;
  padding: 8rpx 32rpx;
  box-sizing: border-box;
}

.cart-line {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.cart-line:last-child {
  border-bottom: none;
}

.cart-line-img {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--surface-2);
}

.cart-line-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.cart-line-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.cart-line-spec {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.cart-line-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.cart-line-price {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.cart-line-price .symbol {
  font-size: 20rpx;
  font-weight: 500;
}

.cart-empty {
  padding: 96rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-3);
}
