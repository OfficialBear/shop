.mine-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f5f6f8;
}

.profile {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #f5f5f5;
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  background: #fff3e8;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.menu {
  display: block;
  margin-top: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
