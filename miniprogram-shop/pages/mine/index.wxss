.mine-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  background: var(--surface-2);
}

.profile {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--surface-2);
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  background: var(--accent-soft);
}

.profile-info {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.name {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
  color: var(--ink);
}

.sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ink-3);
}

.menu {
  display: block;
  margin-top: 32rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}
