.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 200rpx 64rpx 0;
  background: linear-gradient(180deg, #e9f3ef 0%, #ffffff 38%);
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 160rpx;
}

.brand-logo {
  width: 152rpx;
  height: 152rpx;
  border-radius: 40rpx;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  box-shadow: var(--shadow-card);
}

.brand-title {
  margin-top: 40rpx;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: -0.8rpx;
  color: var(--ink);
}

.brand-sub {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}

.tip {
  margin-top: 56rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-3);
}
