.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 180rpx 56rpx 0;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 140rpx;
}

.brand-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #fff3e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
}

.brand-title {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #222;
}

.brand-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.tip {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
