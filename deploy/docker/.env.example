# 复制为 .env 后按需修改；docker compose 会自动读取与本文件同目录的 .env
#   cp .env.example .env

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=yourpass
MYSQL_DATABASE=shop

# ---------- 宿主机映射端口 ----------
UI_PORT=80
SERVER_PORT=8080

# ---------- JWT（至少 32 字节，务必替换）----------
JWT_ADMINSECRETKEY=please-change-me-32bytes-min-secret
JWT_USERSECRETKEY=please-change-me-32bytes-min-secret
# 走 HTTPS 时设为 true；纯 HTTP 测试用 false，否则管理端登录 Cookie 写不下去
JWT_ADMINCOOKIESECURE=false

# ---------- 微信 ----------
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MCHID=
WECHAT_MCHSERIALNO=
WECHAT_PRIVATEKEY=
WECHAT_APIV3KEY=
WECHAT_NOTIFYURL=

# ---------- 阿里云 OSS ----------
ALIOSS_ENDPOINT=
ALIOSS_BUCKETNAME=
ALIOSS_ACCESSKEYID=
ALIOSS_ACCESSKEYSECRET=
